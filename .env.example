# Optional Azure OpenAI configuration for the server-side API.
# Leave the Azure values blank to use the deterministic offline concierge.
# Never put these values in browser code or commit a populated .env file.
HOST=127.0.0.1
PORT=3000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21